# Secrets: never commit these
.env
*.env
.env.*
*.pem
*.key
credentials.json

# Virtualenv / dependency dirs
.venv/
venv/
node_modules/

# Generated output and logs: add project-specific paths here as they're introduced
output/
logs/
*.log

# OS / editor cruft
.DS_Store
*.swp

# Sandbox placeholders (/dev/null mounts): never stage. Exact names only.
# .mcp.json and the .claude/ names recur under every subdirectory a session
# works in, so they match at any depth. Never list .claude/ wholesale.
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.ripgreprc
/.idea
/.vscode
**/.mcp.json
**/.claude/agents
**/.claude/commands
**/.claude/hooks
**/.claude/launch.json
**/.claude/loop.md
**/.claude/output-styles
**/.claude/routines
**/.claude/scheduled_tasks.json
**/.claude/settings.json
**/.claude/settings.local.json
**/.claude/skills
**/.claude/workflows
# Real at the root in this project: re-include each path it tracks.
!/.claude/hooks
!/.claude/settings.json
